---
import Nav from './Nav.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchButton from './SearchButton.astro';
---

<header class="site-header">
  <div class="site-header-inner prose">
    <a class="site-title" href="/">nagasha</a>
    <Nav />
    <div class="site-header-actions">
      <SearchButton />
      <a href="/rss.xml" aria-label="RSS feed" title="RSS feed" class="icon-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
      </a>
      <a href="https://github.com/Jem256" aria-label="GitHub profile" title="GitHub" class="icon-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.1 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.76.12 3.05.74.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.08.78 2.17v3.22c0 .3.21.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-bg);
    z-index: 20;
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    max-width: 860px;
  }

  .site-title {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    font-size: 1.05rem;
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-left: auto;
  }

  .icon-link {
    color: var(--color-text-muted);
    display: inline-flex;
  }

  .icon-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .site-header-inner {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }
  }
</style>
