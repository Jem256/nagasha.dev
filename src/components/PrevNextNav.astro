---
interface Item {
  id: string;
  data: { title: string };
}

interface Props {
  prev?: Item | null;
  next?: Item | null;
  basePath: string;
}

const { prev, next, basePath } = Astro.props;
---

{
  (prev || next) && (
    <nav class="prev-next" aria-label="Post navigation">
      <div>
        {prev && (
          <a href={`${basePath}${prev.id}/`} rel="prev">
            <span class="prev-next-label">&larr; Previous</span>
            <span class="prev-next-title">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div class="prev-next-right">
        {next && (
          <a href={`${basePath}${next.id}/`} rel="next">
            <span class="prev-next-label">Next &rarr;</span>
            <span class="prev-next-title">{next.data.title}</span>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .prev-next-right {
    text-align: right;
    margin-left: auto;
  }

  .prev-next a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .prev-next-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .prev-next-title {
    margin-top: 0.25rem;
  }
</style>
