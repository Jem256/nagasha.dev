---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="back-link" href={href}><span aria-hidden="true">&larr;</span> {label}</a>

<style>
  .back-link {
    display: inline-flex;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>
