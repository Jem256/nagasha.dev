---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="prose site-footer-inner">
    <p>
      Built by nagasha &middot; <a href="https://github.com/Jem256">GitHub</a> &middot;
      <a href="/rss.xml">RSS</a> &middot; <a href="https://github.com/Jem256/nagasha.dev">Source</a>
    </p>
    <p class="muted">&copy; {year} nagasha</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4.5rem;
  }

  .site-footer-inner {
    padding-top: 1.75rem;
    padding-bottom: 3rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .site-footer-inner a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer-inner a:hover {
    color: var(--color-text);
  }

  .muted {
    margin-top: 0.4rem;
  }
</style>
