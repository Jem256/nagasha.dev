<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4.5rem;
  }

  .site-footer-inner {
    padding-top: 1.75rem;
    padding-bottom: 3rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .site-footer-inner a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer-inner a:hover {
    color: var(--color-text);
  }

  .footer-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-icons a {
    display: inline-flex;
  }

  .muted {
    margin-top: 0.4rem;
  }
</style>
