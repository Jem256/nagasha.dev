---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';
import { byDateDesc, published } from '../lib/sort';

const recentPosts = byDateDesc(published(await getCollection('blog'))).slice(0, 6);

const nowEntry = await getEntry('pages', 'now');
const NowContent = nowEntry ? (await render(nowEntry)).Content : null;
---

<BaseLayout title="nagasha — Bitcoin & Lightning open source">
  <div class="prose home">
    <section class="hero">
      <img class="portrait" src="/images/avatar.png" alt="nagasha's profile picture" width="200" height="200" />
      <div class="hero-text">
        <p>
          I'm nagasha, an engineer working on Bitcoin and Lightning open source. I contribute to{' '}
          <a href="/projects/polar/">Polar</a> under a Btrust grant, organize{' '}
          <a href="/projects/bitdevs-kampala/">BitDevs Kampala</a>, and document what I'm learning here.
        </p>
      </div>
    </section>

    <h2 class="section-label">Writing</h2>
    <ul class="post-list">
      {
        recentPosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </li>
        ))
      }
    </ul>
    <a class="more-link" href="/blog/">All posts &rarr;</a>

    {
      NowContent && (
        <section class="home-section now-snapshot">
          <h2 class="section-label">Right now</h2>
          <div class="now-content">
            <NowContent />
          </div>
          <a class="more-link" href="/now/">Full /now &rarr;</a>
        </section>
      )
    }

    <section class="home-section home-links">
      <a href="https://github.com/Jem256">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin: 1rem 0 3.5rem;
  }

  .portrait {
    width: 128px;
    height: 128px;
    flex-shrink: 0;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .hero-text p {
    margin: 0;
    font-size: 1.1rem;
  }

  .home-section {
    margin-top: 3.5rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .post-list a {
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.012em;
  }

  .post-list a:hover {
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 65%, transparent);
    text-underline-offset: 3px;
  }

  .post-list time {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .more-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .now-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .home-links {
    display: flex;
    gap: 1.25rem;
  }

  @media (max-width: 560px) {
    .hero {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
