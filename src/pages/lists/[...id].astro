---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('lists');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
---

<EntryLayout
  id={entry.id}
  collection="lists"
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  tags={entry.data.tags}
  hasMermaid={remarkPluginFrontmatter.hasMermaid}
>
  <Content />

  {
    entry.data.items.length > 0 && (
      <ul class="curated-items">
        {entry.data.items.map((item) => (
          <li>
            {item.url ? <a href={item.url}>{item.label}</a> : <span>{item.label}</span>}
            {item.note && <span class="curated-note"> — {item.note}</span>}
          </li>
        ))}
      </ul>
    )
  }
</EntryLayout>

<style>
  .curated-items {
    margin: 1.5rem 0 0;
    padding-left: 1.2rem;
  }

  .curated-items li {
    margin: 0.4rem 0;
  }

  .curated-note {
    color: var(--color-text-muted);
  }
</style>
