---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { formatDate } from '../../lib/date';
import { byDateDesc, published } from '../../lib/sort';

const entries = byDateDesc(published(await getCollection('til')));
---

<BaseLayout title="Today I Learned" description="Short, quick notes — almost like commit messages.">
  <div class="prose">
    <h1>Today I Learned</h1>
    <p class="section-intro">Small, quick notes from day-to-day work — almost like commit messages.</p>

    <ul class="til-list">
      {
        entries.map((entry) => (
          <li>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            <a href={`/til/${entry.id}/`}>{entry.data.title}</a>
            <TagList tags={entry.data.tags} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .section-intro {
    color: var(--color-text-muted);
  }

  .til-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .til-list li {
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .til-list time {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    min-width: 7rem;
  }

  .til-list a {
    text-decoration: none;
    font-weight: 500;
  }

  .til-list a:hover {
    color: var(--color-accent);
  }
</style>
