---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/date';
import { byDateDesc } from '../../lib/sort';

const entries = byDateDesc(await getCollection('talks'));

const TYPE_LABELS: Record<string, string> = {
  talk: 'Talk',
  interview: 'Interview',
  podcast: 'Podcast',
  'guest-post': 'Guest post',
  mention: 'Mention',
};
---

<BaseLayout title="Talks & Press" description="Talks, workshops, interviews, and external coverage.">
  <div class="prose">
    <h1>Talks &amp; Press</h1>
    <p class="section-intro">
      Talks, workshops, interviews, and coverage elsewhere. External, third-party mentions are the strongest
      form of verification for open source work, so this list stays current.
    </p>

    <ul class="talks-list">
      {
        entries.map((entry) => (
          <li>
            <span class="talk-type">{TYPE_LABELS[entry.data.type]}</span>
            <a href={entry.data.url}>{entry.data.title}</a>
            <p class="talk-meta">
              {entry.data.outlet} &middot; <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .section-intro {
    color: var(--color-text-muted);
  }
  .talks-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .talks-list li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--color-border);
  }
  .talk-type {
    display: inline-block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-accent);
    margin-right: 0.6rem;
  }
  .talks-list a {
    font-weight: 500;
    text-decoration: none;
  }
  .talks-list a:hover {
    color: var(--color-accent);
  }
  .talk-meta {
    margin: 0.3rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
