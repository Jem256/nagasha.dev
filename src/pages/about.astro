---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing content/pages/about.md');
const { Content } = await render(entry);
---

<BaseLayout title="About" description="Civil engineer turned self-taught frontend developer turned full-time Bitcoin open source contributor.">
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
