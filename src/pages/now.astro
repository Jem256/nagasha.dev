---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/date';

const entry = await getEntry('pages', 'now');
if (!entry) throw new Error('Missing content/pages/now.md');
const { Content } = await render(entry);
---

<BaseLayout title="Now" description="What I'm currently working on, reading, and learning.">
  <article class="prose">
    <h1>{entry.data.title}</h1>
    {entry.data.updated && <p class="updated-note">Last updated {formatDate(entry.data.updated)}</p>}
    <Content />
  </article>
</BaseLayout>

<style>
  .updated-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>
