---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="prose not-found">
    <h1>404</h1>
    <p>This page doesn't exist — it may have moved, or the link is out of date.</p>
    <p><a href="/">Back to the homepage</a> or try the search (press <kbd>/</kbd>).</p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: 4rem 1.25rem;
    text-align: center;
  }

  .not-found h1 {
    font-size: 3rem;
    color: var(--color-accent);
  }
</style>
